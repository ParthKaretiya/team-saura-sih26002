{
  "distance_influence": 25,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "road_access == PRIVATE", "multiply_by": "0" },
    { "if": "hgv == NO", "multiply_by": "0" },
    { "if": "max_weight < 12", "multiply_by": "0" },
    { "if": "max_height < 3.8", "multiply_by": "0" },
    { "if": "max_width < 2.5", "multiply_by": "0" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "1.0" },
    { "if": "road_class == PRIMARY", "multiply_by": "0.9" },
    { "if": "road_class == SECONDARY", "multiply_by": "0.7" },
    { "if": "road_class == TERTIARY", "multiply_by": "0.4" },
    { "if": "road_class == UNCLASSIFIED || road_class == RESIDENTIAL", "multiply_by": "0.2" },
    { "if": "road_class == TRACK || road_class == SERVICE", "multiply_by": "0.05" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed * 0.70" },
    { "if": "true", "limit_to": "60" },
    { "if": "road_class == SECONDARY", "limit_to": "45" },
    { "if": "road_class == TERTIARY || road_class == UNCLASSIFIED", "limit_to": "25" },
    { "if": "road_environment == FORD || road_environment == FERRY", "limit_to": "10" }
  ]
}