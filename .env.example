# ==============================================================================
# SauraRoute - Environment Configuration Example
# Copy this file to '.env' and fill in the values for local development.
# DO NOT commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# --- Application Ports ---
API_PORT=3000
ML_PORT=5000
WEB_PORT=8080

# --- Database Configurations ---
# Placeholder for database credentials. 
# Type (e.g., PostgreSQL, PostGIS, SQLite) is to be determined in the design phase.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sauraroute_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_URL=postgresql://postgres:your_secure_password_here@localhost:5432/sauraroute_db

# --- Authentication & Security ---
JWT_SECRET=your_jwt_secret_key_change_me_in_production
SESSION_SECRET=your_session_secret_key_change_me_in_production

# --- External GIS / Mapping Service Keys (Provisional) ---
# Note: Specific map provider to be finalized after GIS research.
MAPBOX_ACCESS_TOKEN=pk.mapbox_token_placeholder
GOOGLE_MAPS_API_KEY=google_maps_api_key_placeholder
OPENWEATHER_API_KEY=openweather_api_key_placeholder

# --- Logging & Debugging ---
NODE_ENV=development
LOG_LEVEL=debug
DEBUG=true
